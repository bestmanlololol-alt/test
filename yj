        Size = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = Lib.Scheme.MainColor,
        BackgroundTransparency = 0.1,
        BorderSizePixel = 0,
        Parent = main,
    })
    Round(titleBar, 12)
    Create("Frame", {
        Size = UDim2.new(1, 0, 0, 20),
        Position = UDim2.new(0, 0, 1, -20),
        BackgroundColor3 = Lib.Scheme.MainColor,
        BorderSizePixel = 0,
        Parent = titleBar,
    })

    local accentLine = Create("Frame", {
        Size = UDim2.new(1, -24, 0, 2),
        Position = UDim2.new(0, 12, 1, -1),
        BackgroundColor3 = Lib.Scheme.AccentColor,
        BorderSizePixel = 0,
        Parent = titleBar,
    })
    Gradient(accentLine, Lib.Scheme.AccentColor, Lib.Scheme.AccentSecondary, 0)

    Create("TextLabel", {
        Position = UDim2.fromOffset(18, 8),
        Size = UDim2.new(0, 200, 0, 18),
        BackgroundTransparency = 1,
        Font = Lib.Scheme.FontBold,
        Text = title or "Lesbian.Lolz",
        TextSize = 16,
        TextColor3 = Lib.Scheme.WhiteColor,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = titleBar,
    })

    Create("TextLabel", {
        Position = UDim2.fromOffset(18, 26),
        Size = UDim2.new(0, 260, 0, 14),
        BackgroundTransparency = 1,
        Font = Lib.Scheme.Font,
        Text = subtitle or "wraith & revenant",
        TextSize = 11,
        TextColor3 = Lib.Scheme.SubFontColor,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = titleBar,
    })

    -- Buttons
    local function makeTbBtn(text, offset, color)
        local btn = Create("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, offset, 0.5, 0),
            Size = UDim2.fromOffset(22, 22),
            BackgroundColor3 = color or Lib.Scheme.SecondaryColor,
            BackgroundTransparency = 0.2,
            BorderSizePixel = 0,
            Font = Lib.Scheme.FontBold,
            Text = text,
            TextSize = 14,
            TextColor3 = Lib.Scheme.WhiteColor,
            AutoButtonColor = false,
            Parent = titleBar,
        })
        Round(btn, 6)
        Stroke(btn, Lib.Scheme.OutlineColor, 1, 0.5)
        btn.MouseEnter:Connect(function()
            Tween(btn, 0.15, { BackgroundTransparency = 0 })
        end)
        btn.MouseLeave:Connect(function()
            Tween(btn, 0.15, { BackgroundTransparency = 0.2 })
        end)
        return btn
    end

    local minimize = makeTbBtn("–", -66)
    local unload   = makeTbBtn("×", -34, Color3.fromRGB(120, 40, 55))

    MakeDraggable(main, titleBar)

    -- Sidebar
    local sidebar = Create("Frame", {
        Name = "Sidebar",
        Position = UDim2.fromOffset(0, 44),
        Size = UDim2.new(0, 140, 1, -44),
        BackgroundColor3 = Lib.Scheme.MainColor,
        BackgroundTransparency = 0.35,
        BorderSizePixel = 0,
        Parent = main,
    })

    local tabList = Create("Frame", {
        Name = "TabList",
        Position = UDim2.fromOffset(0, 12),
        Size = UDim2.new(1, 0, 1, -12),
        BackgroundTransparency = 1,
        Parent = sidebar,
    })
    Create("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 4),
        Parent = tabList,
    })

    -- Content area
    local content = Create("Frame", {
        Name = "Content",
        Position = UDim2.fromOffset(140, 44),
        Size = UDim2.new(1, -140, 1, -44),
        BackgroundTransparency = 1,
        Parent = main,
    })

    -- Minimize logic
    local minimized = false
    local fullSize = UDim2.fromOffset(620, 420)
    local minSize  = UDim2.fromOffset(620, 44)
    minimize.Activated:Connect(function()
        minimized = not minimized
        Tween(main, 0.3, {
            Size = minimized and minSize or fullSize,
        }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        if minimized then
            sidebar.Visible = false
            content.Visible = false
            minimize.Text = "+"
        else
            task.wait(0.15)
            sidebar.Visible = true
            content.Visible = true
            minimize.Text = "–"
        end
    end)

    -- Window keybind
    local keybind = Instance.new("BindableEvent")
    Lib.ToggleKeybind = keybind
    local visible = true
    unload.Activated:Connect(function()
        gui.Enabled = false
    end)
    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.RightShift then
            visible = not visible
            gui.Enabled = visible
        end
    end)

    return {
        frame = main,
        sidebar = sidebar,
        tabList = tabList,
        content = content,
        gui = gui,
    }
end

