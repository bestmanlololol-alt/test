function Widget:AddButton(text, callback)
    local btn = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundColor3 = Lib.Scheme.SecondaryColor,
        BorderSizePixel = 0,
        Font = Lib.Scheme.FontMedium,
        Text = text,
        TextSize = 12,
        TextColor3 = Lib.Scheme.FontColor,
        AutoButtonColor = false,
        Parent = self._frame,
    })
    Round(btn, 8)
    Stroke(btn, Lib.Scheme.OutlineColor, 1, 0.5)
    btn.MouseEnter:Connect(function()
        Tween(btn, 0.15, { BackgroundColor3 = Lib.Scheme.SecondaryColor:Lerp(Lib.Scheme.AccentColor, 0.15) })
    end)
    btn.MouseLeave:Connect(function()
        Tween(btn, 0.15, { BackgroundColor3 = Lib.Scheme.SecondaryColor })
    end)
    btn.Activated:Connect(function()
        pcall(callback or function() end)
    end)
    return btn
end

function Widget:AddToggle(id, default, callback)
    local holder = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        Parent = self._frame,
    })
    Create("TextLabel", {
        Position = UDim2.fromOffset(0, 4),
        Size = UDim2.new(1, -40, 0, 18),
        BackgroundTransparency = 1,
        Font = Lib.Scheme.Font,
        Text = id,
        TextSize = 12,
        TextColor3 = Lib.Scheme.FontColor,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = holder,
    })

    local track = Create("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(34, 18),
        BackgroundColor3 = Lib.Scheme.SecondaryColor,
        BorderSizePixel = 0,
        Parent = holder,
    })
    Round(track, 9)
    Stroke(track, Lib.Scheme.OutlineColor, 1, 0.4)

    local thumb = Create("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 2, 0.5, 0),
        Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = Lib.Scheme.SubFontColor,
        BorderSizePixel = 0,
        Parent = track,
    })
    Round(thumb, 7)

    local btn = Create("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        Parent = track,
    })

    local value = default == true
    local function set(newVal, fire)
        value = newVal == true
        if value then
            Tween(track, 0.18, { BackgroundColor3 = Lib.Scheme.AccentColor })
            Tween(thumb, 0.18, { Position = UDim2.new(1, -16, 0.5, 0), BackgroundColor3 = Lib.Scheme.WhiteColor })
        else
            Tween(track, 0.18, { BackgroundColor3 = Lib.Scheme.SecondaryColor })
            Tween(thumb, 0.18, { Position = UDim2.new(0, 2, 0.5, 0), BackgroundColor3 = Lib.Scheme.SubFontColor })
        end
        if fire then pcall(callback or function() end, value) end
    end
    set(value, false)
    btn.Activated:Connect(function() set(not value, true) end)

    local obj = {
        Value = value,
        SetValue = function(_, v) set(v, true) end,
    }
    self.toggles[id] = obj
    return obj
end

function Widget:AddSlider(id, min, max, default, callback)
    local holder = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundTransparency = 1,
