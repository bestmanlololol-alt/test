local notifyContainer

local function ensureNotifyContainer()
    if notifyContainer and notifyContainer.Parent then return notifyContainer end
    local gui = Create("ScreenGui", {
        Name = "LesbianNotify",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 100,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = pcall(function() return gethui() end) and gethui() or CoreGui,
    })
    notifyContainer = Create("Frame", {
        Name = "Container",
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -16, 1, -16),
        Size = UDim2.fromOffset(320, 400),
        BackgroundTransparency = 1,
        Parent = gui,
    })
    Create("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 8),
        Parent = notifyContainer,
    })
    return notifyContainer
end

local function Toast(opts)
    local container = ensureNotifyContainer()
    local title    = opts.Title or opts.title or "Notification"
    local content  = opts.Description or opts.content or ""
    local duration = opts.Time or opts.duration or 5
    local kind     = opts.Kind or opts.kind or "info"

    local accent = Lib.Scheme.AccentColor
    if kind == "success" then accent = Color3.fromRGB(120, 220, 140) end
    if kind == "error"   then accent = Color3.fromRGB(240, 100, 110) end
    if kind == "warn"    then accent = Color3.fromRGB(255, 200, 90)  end

    local frame = Create("Frame", {
        Name = "Toast",
        Size = UDim2.fromOffset(320, 64),
        BackgroundColor3 = Lib.Scheme.SecondaryColor,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        Parent = container,
    })
    Round(frame, 10)
    Stroke(frame, accent, 1, 0.7)
    Gradient(frame, Lib.Scheme.SecondaryColor, Lib.Scheme.BackgroundColor, 90)

    local bar = Create("Frame", {
        Size = UDim2.new(0, 3, 1, -16),
        Position = UDim2.new(0, 6, 0, 8),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        Parent = frame,
    })
    Round(bar, 2)

    local titleLbl = Create("TextLabel", {
        Position = UDim2.fromOffset(18, 10),
        Size = UDim2.new(1, -26, 0, 20),
        BackgroundTransparency = 1,
        Font = Lib.Scheme.FontBold,
        Text = title,
        TextSize = 14,
        TextColor3 = Lib.Scheme.WhiteColor,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })

    local bodyLbl = Create("TextLabel", {
        Position = UDim2.fromOffset(18, 30),
        Size = UDim2.new(1, -26, 0, 28),
        BackgroundTransparency = 1,
        Font = Lib.Scheme.Font,
        Text = content,
        TextSize = 12,
        TextColor3 = Lib.Scheme.SubFontColor,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Parent = frame,
    })

    frame.Size = UDim2.fromOffset(0, 64)
    Tween(frame, 0.28, { Size = UDim2.fromOffset(320, 64) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    task.delay(duration, function()
        Tween(frame, 0.22, { Size = UDim2.fromOffset(0, 64), BackgroundTransparency = 1 })
        task.wait(0.25)
        frame:Destroy()
    end)
end

function Lib:Notification()
    return {
        Notify = function(_, kind, title, content, duration)
            Toast({
                Title = title,
                Description = content,
                Time = duration or 5,
                Kind = kind or "info",
            })
        end,
    }
end

function Lib:Notify(opts)
    Toast(opts)
end

