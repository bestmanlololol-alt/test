    })
    local btn = Create("TextButton", {
        Position = UDim2.fromOffset(0, 6),
        Size = UDim2.new(1, 0, 0, 20),
        BackgroundColor3 = Lib.Scheme.SecondaryColor,
        BorderSizePixel = 0,
        Font = Lib.Scheme.Font,
        Text = tostring(default),
        TextSize = 11,
        TextColor3 = Lib.Scheme.FontColor,
        AutoButtonColor = false,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = holder,
    })
    btn.Text = " " .. tostring(default)
    Round(btn, 6)
    Stroke(btn, Lib.Scheme.OutlineColor, 1, 0.4)
    btn.Size = UDim2.new(1, 0, 0, 20)
    holder.Size = UDim2.new(1, 0, 0, 30)

    local open = false
    local list = Create("Frame", {
        Visible = false,
        Position = UDim2.new(0, 0, 1, 4),
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = Lib.Scheme.MainColor,
        BorderSizePixel = 0,
        ZIndex = 20,
        Parent = btn,
    })
    Round(list, 6)
    Stroke(list, Lib.Scheme.OutlineColor, 1, 0.4)

    local scroll = Create("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Lib.Scheme.AccentColor,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ZIndex = 21,
        Parent = list,
    })
    Create("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 1),
        Parent = scroll,
    })

    local value = default
    local function set(v, fire)
        value = v
        btn.Text = " " .. tostring(v)
        if fire then pcall(callback or function() end, v) end
    end

    local selectedLabel
    for _, opt in ipairs(options) do
        local optBtn = Create("TextButton", {
            Size = UDim2.new(1, -4, 0, 22),
            BackgroundColor3 = Lib.Scheme.SecondaryColor,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Font = Lib.Scheme.Font,
            Text = "  " .. tostring(opt),
            TextSize = 11,
            TextColor3 = Lib.Scheme.FontColor,
            TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false,
            ZIndex = 22,
            Parent = scroll,
        })
        Round(optBtn, 4)
        optBtn.MouseEnter:Connect(function()
            Tween(optBtn, 0.1, { BackgroundTransparency = 0, BackgroundColor3 = Lib.Scheme.SecondaryColor:Lerp(Lib.Scheme.AccentColor, 0.2) })
        end)
        optBtn.MouseLeave:Connect(function()
            Tween(optBtn, 0.1, { BackgroundTransparency = 1 })
        end)
        optBtn.Activated:Connect(function()
            set(opt, true)
            open = false
            Tween(list, 0.15, { Size = UDim2.new(1, 0, 0, 0) })
            task.wait(0.15)
            list.Visible = false
        end)
    end

    btn.Activated:Connect(function()
        open = not open
        if open then
            list.Visible = true
            local count = math.min(#options, 6)
            Tween(list, 0.18, { Size = UDim2.new(1, 0, 0, count * 23 + 4) }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        else
            Tween(list, 0.15, { Size = UDim2.new(1, 0, 0, 0) })
            task.wait(0.15)
            list.Visible = false
        end
    end)

    set(default, false)

    local obj = {
        Value = value,
        SetValue = function(_, v) set(v, true) end,
        Refresh = function(_, newOptions, newValue)
            options = newOptions
            for _, c in ipairs(scroll:GetChildren()) do
                if c:IsA("TextButton") then c:Destroy() end
            end
            for _, opt in ipairs(newOptions) do
                local optBtn = Create("TextButton", {
                    Size = UDim2.new(1, -4, 0, 22),
                    BackgroundColor3 = Lib.Scheme.SecondaryColor,
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    Font = Lib.Scheme.Font,
                    Text = "  " .. tostring(opt),
                    TextSize = 11,
                    TextColor3 = Lib.Scheme.FontColor,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false,
                    ZIndex = 22,
                    Parent = scroll,
                })
                Round(optBtn, 4)
                optBtn.Activated:Connect(function()
                    set(opt, true)
                    open = false
                    Tween(list, 0.15, { Size = UDim2.new(1, 0, 0, 0) })
                    task.wait(0.15)
                    list.Visible = false
                end)
            end
            if newValue then set(newValue, false) end
        end,
        Get = function(_) return value end,
    }
    self.options[id] = obj
    return obj
end

function Widget:AddKeybind(id, default, callback)
    local holder = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        Parent = self._frame,
    })
    Create("TextLabel", {
        Position = UDim2.fromOffset(0, 4),
        Size = UDim2.new(1, -80, 0, 18),
        BackgroundTransparency = 1,
        Font = Lib.Scheme.Font,
        Text = id,
        TextSize = 12,
        TextColor3 = Lib.Scheme.FontColor,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = holder,
    })
    local btn = Create("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(70, 20),
        BackgroundColor3 = Lib.Scheme.SecondaryColor,
        BorderSizePixel = 0,
        Font = Lib.Scheme.FontBold,
        Text = tostring(default or "None"),
        TextSize = 11,
        TextColor3 = Lib.Scheme.FontColor,
        AutoButtonColor = false,
        Parent = holder,
    })
    Round(btn, 6)
    Stroke(btn, Lib.Scheme.OutlineColor, 1, 0.4)

    local listening = false
    local key = default
    btn.Activated:Connect(function()
        listening = not listening
        btn.Text = listening and "..." or tostring(key or "None")
        btn.TextColor3 = listening and Lib.Scheme.AccentColor or Lib.Scheme.FontColor
    end)
    UserInputService.InputBegan:Connect(function(input, gp)
        if not listening then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        listening = false
        if input.KeyCode == Enum.KeyCode.Backspace then
            key = nil
            btn.Text = "None"
        else
            key = input.KeyCode
            btn.Text = key.Name
        end
        btn.TextColor3 = Lib.Scheme.FontColor
        pcall(callback or function() end, key)
    end)

    return {
        Value = key,
        Get = function(_) return key end,
        OnClick = function(_, fn) callback = fn end,
    }
end

