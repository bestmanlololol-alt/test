function Lib:AddWindow(title, subtitle)
    local win = buildWindow(title, subtitle)
    local windowObj = {
        _win = win,
        Tabs = {},
    }

    function windowObj:AddTab(name, icon)
        local tab = buildTab(win, name, icon)
        local wrappedTab = {
            _tab = tab,
        }
        function wrappedTab:AddSection(sectionName, side)
            local sec = tab:AddSection(sectionName, side)
            return wrapSection(sec._section, sec._frame, sec._layout)
        end
        function wrappedTab:AddLeftGroupbox(sectionName)
            return self:AddSection(sectionName, "left")
        end
        function wrappedTab:AddRightGroupbox(sectionName)
            return self:AddSection(sectionName, "right")
        end
        table.insert(windowObj.Tabs, wrappedTab)
        if #windowObj.Tabs == 1 then
            tab.button.Activated:Fire()
            task.defer(function() tab.button.Activated:Fire() end)
        end
        return wrappedTab
    end

    -- Auto-select first tab
    task.defer(function()
        for _, c in ipairs(win.content:GetChildren()) do
            if c:IsA("ScrollingFrame") then c.Visible = false end
        end
        for _, t in ipairs(win.tabList:GetChildren()) do
            if t:IsA("TextButton") then
                t.BackgroundTransparency = 1
                t.TextColor3 = Lib.Scheme.SubFontColor
            end
        end
        local firstBtn = win.tabList:FindFirstChildWhichIsA("TextButton")
        if firstBtn then
            firstBtn.BackgroundTransparency = 0
            firstBtn.TextColor3 = Lib.Scheme.WhiteColor
            local page = win.content:FindFirstChild(firstBtn.Name .. "Page")
            if page then page.Visible = true end
        end
    end)

    function windowObj:SetNotifySide(side) end
    function windowObj:Toggle() end
    function windowObj:Unload()
        if Lib.ScreenGui then Lib.ScreenGui:Destroy() end
    end
    function windowObj:OnUnload(fn) end

    return windowObj
end

