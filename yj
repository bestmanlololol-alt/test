--==========================================================================
-- Helpers
--==========================================================================
local function Tween(inst, time, goals, style, dir)
    local t = TweenService:Create(inst, TweenInfo.new(
        time or 0.18,
        style or Enum.EasingStyle.Quad,
        dir or Enum.EasingDirection.Out
    ), goals)
    t:Play()
    return t
end

local function Round(inst, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or Lib.CornerRadius)
    c.Parent = inst
    table.insert(Lib.Corners, c)
    return c
end

local function Stroke(inst, col, thick, trans)
    local s = Instance.new("UIStroke")
    s.Color = col or Lib.Scheme.OutlineColor
    s.Thickness = thick or 1
    s.Transparency = trans or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = inst
    return s
end

local function Create(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props) do
        if k ~= "Parent" then inst[k] = v end
    end
    inst.Parent = props.Parent
    return inst
end

local function Gradient(inst, c1, c2, rot, offset)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new(c1, c2 or c1)
    g.Rotation = rot or 90
    if offset then g.Offset = offset end
    g.Parent = inst
    return g
end

local function MakeDraggable(frame, handle)
    handle = handle or frame
    local dragging, start, startPos, dragInput
    local moved = false
    handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
           and input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging  = true
        moved     = false
        dragInput = input
        start     = input.Position
        startPos  = frame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end)
    handle.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
           and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - start
        if delta.Magnitude > 3 then moved = true end
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end)
    return function() return moved end
end

