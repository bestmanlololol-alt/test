local function buildTab(win, title, icon)
    local btn = Create("TextButton", {
        Name = title,
        Size = UDim2.new(1, -20, 0, 34),
        BackgroundColor3 = Lib.Scheme.SecondaryColor,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Font = Lib.Scheme.FontMedium,
        Text = "  " .. title,
        TextSize = 13,
        TextColor3 = Lib.Scheme.SubFontColor,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false,
        Parent = win.tabList,
    })
    Round(btn, 8)

    local page = Create("ScrollingFrame", {
        Name = title .. "Page",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Lib.Scheme.AccentColor,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        Parent = win.content,
    })
    Create("UIPadding", {
        PaddingTop = UDim.new(0, 12),
        PaddingBottom = UDim.new(0, 12),
        PaddingLeft = UDim.new(0, 12),
        PaddingRight = UDim.new(0, 12),
        Parent = page,
    })

    local tabObj = {
        page = page,
        button = btn,
        sections = {},
        selectedColor = Lib.Scheme.AccentColor,
    }

    btn.Activated:Connect(function()
        for _, c in ipairs(win.content:GetChildren()) do
            if c:IsA("ScrollingFrame") then c.Visible = false end
        end
        page.Visible = true
        for _, t in ipairs(win.tabList:GetChildren()) do
            if t:IsA("TextButton") then
                Tween(t, 0.15, {
                    BackgroundTransparency = 1,
                    TextColor3 = Lib.Scheme.SubFontColor,
                })
            end
        end
        Tween(btn, 0.15, {
            BackgroundTransparency = 0,
            TextColor3 = Lib.Scheme.WhiteColor,
        })
    end)

    -- Sections
    function tabObj:AddSection(name, side)
        local section = Instance.new("Frame")
        section.Name = name
        section.BackgroundColor3 = Lib.Scheme.MainColor
        section.BackgroundTransparency = 0.35
        section.BorderSizePixel = 0
        section.Size = UDim2.new(0.5, -8, 0, 0)
        section.AutomaticSize = Enum.AutomaticSize.Y
        section.Parent = page
        Round(section, 10)
        Stroke(section, Lib.Scheme.OutlineColor, 1, 0.6)

        local pad = Instance.new("UIPadding")
        pad.PaddingTop = UDim.new(0, 8)
        pad.PaddingBottom = UDim.new(0, 8)
        pad.PaddingLeft = UDim.new(0, 10)
        pad.PaddingRight = UDim.new(0, 10)
        pad.Parent = section

        local layout = Instance.new("UIListLayout")
        layout.FillDirection = Enum.FillDirection.Vertical
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0, 4)
        layout.Parent = section

        local lbl = Instance.new("TextLabel")
        lbl.BackgroundTransparency = 1
        lbl.Size = UDim2.new(1, 0, 0, 18)
        lbl.Font = Lib.Scheme.FontBold
        lbl.Text = name
        lbl.TextSize = 12
        lbl.TextColor3 = Lib.Scheme.AccentColor
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.LayoutOrder = 0
        lbl.Parent = section

        -- Position: even = left, odd = right. If section list is empty and side given, use it.
        local leftCount, rightCount = 0, 0
        for _, s in ipairs(tabObj.sections) do
            if s.position == "left" then leftCount += 1 else rightCount += 1 end
        end
        local position = side
        if not position then
            position = (leftCount <= rightCount) and "left" or "right"
        end
        if position == "left" then
            section.Position = UDim2.new(0, 0, 0, 0)
        else
            section.Position = UDim2.new(0.5, 8, 0, 0)
        end

        local sectionObj = {
            frame = section,
            position = position,
            order = #tabObj.sections,
        }
        table.insert(tabObj.sections, sectionObj)

        -- Vertical flow: each section needs to stack.
        local container = page
        local totalHeight = 0
        for _, s in ipairs(tabObj.sections) do
            s.frame.Position = UDim2.new(
                s.position == "left" and 0 or 0.5,
                s.position == "left" and 0 or 8,
                0, totalHeight
            )
            totalHeight += s.frame.AbsoluteSize.Y + 12
        end

        local function reflow()
            task.wait()
            local y = 0
            for _, s in ipairs(tabObj.sections) do
                local posX = s.position == "left" and UDim2.new(0, 0, 0, y) or UDim2.new(0.5, 8, 0, y)
                if s.position == "right" then
                    -- Find matching left section
                end
                Tween(s.frame, 0.2, { Position = posX })
            end
            -- Simpler: two columns, independent y
            local leftY, rightY = 0, 0
            for _, s in ipairs(tabObj.sections) do
                if s.position == "left" then
                    s.frame.Position = UDim2.new(0, 0, 0, leftY)
                    leftY += s.frame.AbsoluteSize.Y + 10
                else
                    s.frame.Position = UDim2.new(0.5, 8, 0, rightY)
                    rightY += s.frame.AbsoluteSize.Y + 10
                end
            end
        end
        task.defer(reflow)
        section:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            task.defer(reflow)
        end)

        return setmetatable({ _section = sectionObj, _frame = section, _layout = layout }, {
            __index = {},
        })
    end

    return tabObj
end

